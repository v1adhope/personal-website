---
import type { CollectionEntry } from "astro:content";
import PostDate from "./PostDate.astro";
import TagList from "./TagList.astro";
interface Props { post: CollectionEntry<"blog">; showYear?: boolean; }
const { post, showYear = true } = Astro.props;
---

<li class="post-row">
    <PostDate date={post.data.pubDate} stacked showYear={showYear} />
    <div class="post-content">
        <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
        <p>{post.data.description}</p>
        <TagList tags={post.data.tags} />
    </div>
</li>

<style>
    .post-row { display: grid; gap: var(--md-sys-spacing-2); min-width: 0; }
    .post-content { min-width: 0; }
    h3 { font: var(--md-sys-typescale-headline-small); }
    h3 a { text-decoration: none; }
    h3 a:hover { text-decoration: underline; }
    p { margin-block: var(--md-sys-spacing-2) var(--md-sys-spacing-4); color: var(--md-sys-color-on-surface-variant); overflow-wrap: anywhere; }
    @media (min-width: 600px) { .post-row { grid-template-columns: var(--md-comp-post-list-date-column-width) minmax(0, 1fr); gap: var(--md-sys-layout-grid-gap); } }
</style>
