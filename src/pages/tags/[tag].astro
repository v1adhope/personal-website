---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import PostList from "../../components/PostList.astro";
import TextLink from "../../components/TextLink.astro";
import {
  getTagCounts,
  getTagLabel,
  getPosts,
  newestFirst,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTagCounts(posts).map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const label = getTagLabel(tag);
---

<BaseLayout pageTitle={label}>
  <PageIntro
    eyebrow="Follow a thread"
    title={label}
    count={posts.length}
    description={`Thoughts and notes on ${label}.`}
  >
    <TextLink href="/tags/">All interests</TextLink>
  </PageIntro>
  <section class="section" aria-label={`Posts about ${tag}`}>
    <PostList posts={newestFirst(posts)} />
  </section>
</BaseLayout>
