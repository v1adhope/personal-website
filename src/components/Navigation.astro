---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
    { href: "/", label: "Home" },
    { href: "/about/", label: "About" },
    { href: "/blog/", label: "Blog" },
    { href: "/tags/", label: "Tags" },
];
const isActive = (href: string) => {
    const path = href.replace(/\/$/, "") || "/";
    return currentPath === path || (path === "/tags" && currentPath.startsWith("/tags/")) || (path === "/blog" && currentPath.startsWith("/posts/"));
};
---

<nav aria-label="Main navigation">
    <ul role="list">
        {links.map(({ href, label }) => (
            <li><a href={href} aria-current={isActive(href) ? (currentPath === (href.replace(/\/$/, "") || "/") ? "page" : "true") : undefined}>{label}</a></li>
        ))}
    </ul>
</nav>

<style>
    nav { width: 100%; }
    ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 0; list-style: none; }
    a { display: flex; align-items: center; justify-content: center; min-height: var(--md-sys-size-touch-target); padding: var(--md-sys-spacing-2) var(--md-sys-spacing-3); border: var(--md-sys-size-border) solid transparent; border-radius: var(--md-comp-navigation-container-shape); color: var(--md-sys-color-on-surface-variant); font: var(--md-sys-typescale-body-medium); text-decoration: none; }
    a:hover { background: var(--md-sys-color-surface-container); color: var(--md-sys-color-primary); }
    a[aria-current] { border-color: var(--md-sys-color-outline); background: var(--md-comp-navigation-active-container-color); color: var(--md-comp-navigation-active-label-color); }
    @media (min-width: 840px) { nav { width: auto; } ul { display: flex; gap: var(--md-sys-spacing-1); } }
</style>
