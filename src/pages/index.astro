---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TagGrid from "../components/TagGrid.astro";
import TextLink from "../components/TextLink.astro";
import { getTagCounts, getPosts, newestFirst } from "../lib/posts";
const posts = newestFirst(await getPosts());
const interests = getTagCounts(posts);
---

<BaseLayout pageTitle="Home">
  <section class="hero" aria-labelledby="intro-title">
    <p class="eyebrow">A personal blog</p>
    <h1 id="intro-title">
      Always a work
      <br class="desktop-break" /> in <em>progress</em>
    </h1>
    <p class="introduction">
      Following my curiosity and paying attention to everyday life.
    </p>
    <TextLink href="/about/">Meet the person behind the notes</TextLink>
  </section>
  <section class="section" aria-labelledby="latest-posts">
    <SectionHeading
      id="latest-posts"
      title="Thoughts, lately"
      href="/blog/"
      linkLabel="All posts"
      count={posts.length}
    />
    <PostList posts={posts.slice(0, 5)} />
  </section>
  <section class="section" aria-labelledby="interests">
    <SectionHeading
      id="interests"
      title="Often on my mind"
      href="/tags/"
      linkLabel="Interests"
      count={interests.length}
    />
    <TagGrid interests={interests.slice(0, 4)} />
  </section>
</BaseLayout>

<style>
  h1 {
    font: var(--md-comp-hero-headline-typography);
  }
  em {
    color: var(--md-sys-color-primary);
  }
  .introduction {
    margin-block: var(--md-sys-spacing-8);
    color: var(--md-sys-color-on-surface-variant);
  }
  .desktop-break {
    display: none;
  }
  @media (min-width: 600px) {
    .desktop-break {
      display: initial;
    }
  }
</style>
