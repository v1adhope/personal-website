---
import Social from "./Social.astro";

const links = [
    {
        name: "github",
        url: "https://github.com/v1adhope",
    },
    {
        name: "LinkedIn",
        url: "https://www.linkedin.com/in/v1adhope",
    },
    {
        name: "Telegram",
        url: "https://t.me/v1adhope",
    },
    {
        name: "RSS",
        url: "/rss.xml",
    },
    {
        name: "Email",
        url: "mailto:vladislavgardner@proton.me",
    },
];
---

<style>
    footer {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }
</style>

<footer>
    <p>
        {links.map(({ name, url }, idx) => (
            <>
                <Social name={name} url={url} />
                {idx < links.length - 1 ? ", " : ""}
            </>
        ))}
    </p>
</footer>
