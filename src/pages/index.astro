---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pageTitle = "Home Page";
const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 5);
const dateFormatter = new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
});
---

<BaseLayout pageTitle={pageTitle}>
    <p>
        I'm Vla, a software engineer. I write about what I'm learning, working on,
        and thinking about.
    </p>
    <p><a href="/about/">More about me</a></p>

    <section aria-labelledby="posts">
        <h2 id="posts">Latest posts</h2>
        <ul class="posts" role="list">
            {posts.map((post) => (
                <li>
                    <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
                    <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                        {dateFormatter.format(post.data.pubDate)}
                    </time>
                    <p>{post.data.description}</p>
                </li>
            ))}
        </ul>
        <p><a href="/blog/">All posts</a></p>
    </section>
</BaseLayout>

<style>
    section {
        margin-top: 2.5rem;
    }

    .posts {
        list-style: none;
        padding: 0;
    }

    .posts li + li {
        margin-top: 1.75rem;
    }

    h3 {
        margin: 0 0 0.25rem;
    }

    time {
        font-size: 0.875rem;
    }

    .posts p {
        margin: 0.5rem 0 0;
    }
</style>
