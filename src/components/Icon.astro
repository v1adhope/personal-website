---
interface Props { name: "arrow-right" | "arrow-up-right" | "code" | "linkedin" | "telegram" | "rss" | "mail"; }
const { name } = Astro.props;
---

<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {name === "arrow-right" && <path d="M4 12h15m-5-5 5 5-5 5" />}
    {name === "arrow-up-right" && <path d="M7 17 17 7M7 7h10v10" />}
    {name === "code" && <path d="m7 7-5 5 5 5m10-10 5 5-5 5M14 4l-4 16" />}
    {name === "linkedin" && <><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M7.5 10v7m0-10v.5M11 17v-7m0 3a3 3 0 0 1 6 0v4" /></>}
    {name === "telegram" && <path d="m3 10 18-7-5 18-5-7-8-4Zm8 4 10-11" />}
    {name === "rss" && <><path d="M4 4a16 16 0 0 1 16 16M4 10a10 10 0 0 1 10 10" /><circle cx="5" cy="19" r="1" /></>}
    {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
</svg>

<style>
    .icon { width: var(--md-sys-size-icon); height: var(--md-sys-size-icon); flex: none; }
</style>
