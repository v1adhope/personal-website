---
import TagLink from "./TagLink.astro";
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

<ul class="tag-list" role="list" aria-label="Post interests">
  {tags.map((tag) => (
    <li>
      <TagLink tag={tag} />
    </li>
  ))}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md-sys-spacing-2);
    padding: 0;
    list-style: none;
  }
</style>
