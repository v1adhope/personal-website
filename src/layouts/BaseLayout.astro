---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  pageTitle: string;
  description?: string;
}
const siteTitle = "Vladislav Gardner";
const {
  pageTitle,
  description = "Thoughts, notes, and things I learn along the way. A personal blog by Vladislav Gardner.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteTitle}
      href="/rss.xml"
    />
    <link
      rel="preload"
      href="/fonts/roboto-serif/roboto-serif-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/roboto-serif/roboto-serif-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle} | {siteTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="site-container">
      <div class="header-layout">
        <Header siteTitle={siteTitle} />
      </div>
      <main id="main-content" class="page-stack" tabindex="-1">
        <slot />
      </main>
      <div class="footer-layout">
        <Footer siteTitle={siteTitle} />
      </div>
    </div>
  </body>
</html>

<style>
  .header-layout {
    padding-block: var(--md-sys-spacing-6);
    border-bottom: var(--md-sys-size-border) solid
      var(--md-sys-color-outline-variant);
  }
  main {
    padding-block: var(--md-sys-spacing-10) var(--md-sys-layout-section-space);
  }
  .footer-layout {
    padding-block: var(--md-sys-layout-section-space) var(--md-sys-spacing-8);
    border-top: var(--md-sys-size-border) solid
      var(--md-sys-color-outline-variant);
  }
  @media (min-width: 840px) {
    .header-layout {
      padding-block: var(--md-sys-spacing-8);
    }
    main {
      padding-block-start: var(--md-sys-spacing-16);
    }
  }
</style>
